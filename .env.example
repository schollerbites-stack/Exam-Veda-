# ==============================================================================
# Exam Veda - Environment Variables Configuration
# ==============================================================================

# Server Port (Railway, Render, Heroku automatically set this). Default: 3000
PORT=3000

# 1. Google Gemini API Key (Optional / Recommended)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# 2. Groq Cloud API Key (Recommended - Ultra-Fast LPU Inference)
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# 3. OpenRouter API Key (Optional - DeepSeek & Llama models)
# Get free key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=

# Host Application URL (used by container runtimes)
APP_URL=http://localhost:3000

